ENVIRONMENT=development
DEBUG=0

# Required service keys. Put real values in .env locally or in Render environment variables.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_HOST=

# Optional Bubble read-only Data API integration.
BUBBLE_API_BASE=
BUBBLE_API_KEY=

# Models and retrieval.
CHAT_MODEL=claude-sonnet-4-6
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
TOP_K=10
MAX_TOP_K=20
PINECONE_TOPK_RAW=30
MAX_CONTEXT_CHARS=14000

# Production safety controls.
ALLOWED_ORIGINS=https://ai.diademperformance.com,https://diadem-51532.bubbleapps.io
MAX_REQUEST_BYTES=262144
RATE_LIMIT_PER_MINUTE=120
MAX_QUERY_CHARS=4000
MAX_HISTORY_TURNS=12
MAX_SESSION_ID_CHARS=128
SESSION_TTL_SECONDS=86400

# Operational logging.
SEARCH_DEBUG_LOGS=0
SEARCH_LOG_MAX_MATCHES=8
SEARCH_LOG_TEXT_PREVIEW=140
